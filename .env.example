PORT=3001
FRONTEND_URL=http://localhost:5173
DB_PATH=./wartracker.db

# Shared secret for mutating requests (POST/PUT/PATCH/DELETE under /api).
# REQUIRED — the backend refuses to start without it, and refuses to start with
# a placeholder. Generate your own; do not paste a value from anywhere public:
#   openssl rand -hex 32
# Then enter the same value in the dashboard under Settings > Guvenlik.
# Minimum 16 characters. GET endpoints stay open.
API_SHARED_SECRET=

# Backup & Disaster Recovery Storage Configuration
# Place outside cloud-synchronized folders (OneDrive, Dropbox) to avoid sync storms.
# Default: ./backups
BACKUP_DIR=./backups
BACKUP_RETENTION_COUNT=7

# Frontend
VITE_API_URL=http://localhost:3001

# Number of proxy hops in front of this process, or empty for none.
# Rate limits key on the client IP. With no proxy this must stay empty: setting
# it lets any caller spoof X-Forwarded-For and hand itself a fresh rate-limit
# bucket per request. Set it to "1" only when something upstream (nginx,
# Caddy, a load balancer) actually rewrites that header.
TRUST_PROXY=

# Set to 1 to stop the RSS and AI cron jobs from running at all.
# Used by CI so the smoke test does not fan out to fifteen live news sites.
DISABLE_SCHEDULED_FETCH=0

# AI features
# 1 = the situation brief's bullets come from the model below; 0 = built from counts only.
# Article summaries use the model whenever it is reachable, regardless of this flag.
BRIEF_MODEL_ENABLED=0
OLLAMA_URL=http://localhost:11434
# Chosen by measurement (2026-09): llama3.2:3b mixed English and Chinese words
# into Turkish summaries; gemma3:4b writes clean Turkish at ~2 s per article
# on an 8 GB GPU. Pull it once with: ollama pull gemma3:4b
OLLAMA_MODEL=gemma3:4b
# Optional cloud fallback. Leave the key empty to stay fully local.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_LANG_GUARD=1
AI_SAFE_MODE=1
